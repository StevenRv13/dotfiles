{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "kitty",
    "source": "/home/steven/Pictures/Monkey-D-Luffy-Gear-5-PNG.png",
    "width": 30,
    "height": 16
  },
  "display": {
    "separator": "  ",
    "color": {
      "separator": "#3399ff"
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "{1}",
      "color": {
        "user": "#ffffff"
      }
    },
    "break",
    // Identidad -> cian electrico
    {
      "type": "os",
      "key": "󱄅 os",
      "keyColor": "#00d4ff"
    },
    {
      "type": "host",
      "key": "󰟀 host",
      "keyColor": "#00aaff"
    },
    {
      "type": "kernel",
      "key": " kernel",
      "keyColor": "#0080ff"
    },
    // Entorno -> blanco brillante
    {
      "type": "shell",
      "key": " sh",
      "keyColor": "#ffffff"
    },
    {
      "type": "de",
      "key": " de",
      "keyColor": "#e0f5ff"
    },
    {
      "type": "wm",
      "key": " wm",
      "keyColor": "#e0f5ff"
    },
    {
      "type": "terminal",
      "key": " term",
      "keyColor": "#c2ecff"
    },
    // Hardware -> azul saturado profundo
    {
      "type": "cpu",
      "key": " cpu",
      "keyColor": "#0066ff"
    },
    {
      "type": "gpu",
      "key": "󰢮 gpu",
      "keyColor": "#0066ff"
    },
    {
      "type": "memory",
      "key": "󰘚 ram",
      "keyColor": "#0047cc"
    },
    {
      "type": "disk",
      "key": " disk",
      "keyColor": "#002a99"
    },
    // Red / misc -> azul cielo saturado
    {
      "type": "uptime",
      "key": " uptime",
      "keyColor": "#00c2ff"
    },
    {
      "type": "packages",
      "key": " pkgs",
      "keyColor": "#00a3d9"
    },
    {
      "type": "localip",
      "key": " ip",
      "keyColor": "#0086b3"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
